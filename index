      const totalStudents = state.students.length;
      
      // Calculate Overall Stats
      let totalAvgSum = 0;
      let passingCount = 0;
      let failingCount = 0;

      const acaciaStudents = state.students.filter(s => s.section.includes('Acacia'));
      const narraStudents = state.students.filter(s => s.section.includes('Narra'));

      const calcSecAvg = (list) => {
        if (!list.length) return 0;
        const sum = list.reduce((acc, s) => acc + parseFloat(calcAverage(s.grades)), 0);
        return (sum / list.length).toFixed(2);
      };

      const acaciaAvg = calcSecAvg(acaciaStudents);
      const narraAvg = calcSecAvg(narraStudents);

      const acaciaPassing = acaciaStudents.filter(s => isPassing(calcAverage(s.grades))).length;
      const narraPassing = narraStudents.filter(s => isPassing(calcAverage(s.grades))).length;

      state.students.forEach(s => {
        const avg = parseFloat(calcAverage(s.grades));
        totalAvgSum += avg;
        if (avg >= 75) passingCount++;
        else failingCount++;
      });

      const genAverage = (totalAvgSum / totalStudents).toFixed(2);
