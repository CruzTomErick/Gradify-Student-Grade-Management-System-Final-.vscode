              <div>
                <span class="text-3xl font-extrabold text-gray-900">${genAverage}</span>
                <p class="text-xs font-semibold text-gray-500 mt-1">Class general average</p>
                <p class="text-[11px] text-gray-400 mt-0.5">Across 2 Grade 7 sections</p>
              </div>
              <div class="w-10 h-10 rounded-full bg-teal-50 text-gradify-teal flex items-center justify-center">
                <i class="fa-solid fa-chart-line text-lg"></i>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex items-start justify-between">
              <div>
                <span class="text-3xl font-extrabold text-gray-900">${passingCount} / ${totalStudents}</span>
                <p class="text-xs font-semibold text-gray-500 mt-1">Passing student</p>
                <p class="text-[11px] text-gray-400 mt-0.5">${passPercentage}% · threshold 75</p>
              </div>
              <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <i class="fa-solid fa-circle-check text-lg"></i>
              </div>
            </div>

            <!-- Card 4 -->
            <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex items-start justify-between">
              <div>
                <span class="text-3xl font-extrabold text-gray-900">${failingCount}</span>
                <p class="text-xs font-semibold text-gray-500 mt-1">Needs support</p>
                <p class="text-[11px] text-gray-400 mt-0.5">General average below 75</p>
