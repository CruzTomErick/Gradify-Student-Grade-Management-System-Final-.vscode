                      <input 
                        type="text" 
                        value="${f.address || ''}" 
                        oninput="state.editForm.address = this.value; state.isEditFormDirty = true;" 
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-gradify-teal bg-white"
                      />
                    </div>
                  </div>
                </div>

                <!-- Guardian Info Panel -->
                <div class="bg-gray-50/50 p-5 rounded-xl border border-gray-100 space-y-4">
                  <h3 class="text-sm font-bold text-gray-900 border-b border-gray-200 pb-2">Guardian and contact information</h3>
                  <p class="text-[11px] text-gray-400">Used for academic updates and student support.</p>

                  <div class="grid grid-cols-2 gap-3 text-xs">
                    <div>
                      <label class="block font-semibold text-gray-700 mb-1">Parent / guardian name *</label>
                      <input 
                        type="text" 
                        value="${f.parentName || ''}" 
                        oninput="state.editForm.parentName = this.value; state.isEditFormDirty = true;" 
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-gradify-teal bg-white"
                      />
                    </div>

                    <div>
                      <label class="block font-semibold text-gray-700 mb-1">Relationship *</label>
                      <select 
                        onchange="state.editForm.relationship = this.value; state.isEditFormDirty = true;"
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-gradify-teal bg-white"
                      >
                        <option value="Mother" ${f.relationship === 'Mother' ? 'selected' : ''}>Mother</option>
                        <option value="Father" ${f.relationship === 'Father' ? 'selected' : ''}>Father</option>
                        <option value="Guardian" ${f.relationship === 'Guardian' ? 'selected' : ''}>Guardian</option>
                      </select>
                    </div>

                    <div>
                      <label class="block font-semibold text-gray-700 mb-1">Mobile number *</label>
                      <input 
                        type="text" 
                        value="${f.mobile || ''}" 
                        oninput="state.editForm.mobile = this.value; state.isEditFormDirty = true;" 
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-gradify-teal bg-white"
                      />
                    </div>

                    <div>
                      <label class="block font-semibold text-gray-700 mb-1">Email address</label>
                      <input 
                        type="email" 
                        value="${f.email || ''}" 
                        oninput="state.editForm.email = this.value; state.isEditFormDirty = true;" 
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-gradify-teal bg-white"
                      />
                    </div>

                    <div class="col-span-2">
                      <label class="block font-semibold text-gray-700 mb-1">Teacher notes</label>
                      <textarea 
                        rows="3" 
                        oninput="state.editForm.teacherNotes = this.value; state.isEditFormDirty = true;" 
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-gradify-teal bg-white"
                      >${f.teacherNotes || ''}</textarea>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Modal Actions -->
              <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-100">
                <button 
                  type="button" 
                  onclick="closeEditStudentModal(true)" 
                  class="px-4 py-2 border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold rounded-lg text-xs transition-colors"
                >
                  Cancel
                </button>
                <button 
                  type="submit" 
                  class="px-5 py-2 bg-gradify-teal hover:bg-gradify-teal-dark text-white font-semibold rounded-lg text-xs transition-colors shadow-sm inline-flex items-center gap-2"
                >
                  <i class="fa-solid fa-check text-xs"></i>
                  <span>Save Changes</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      `;
    }

    // Add Student Modal
    function renderAddStudentModal() {
      if (!state.showAddStudentModal) return '';
      const a = state.addForm;

      return `
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
          <div class="bg-white rounded-2xl border border-gray-200 shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto custom-scrollbar p-8 space-y-6">
            <div class="flex items-center justify-between pb-4 border-b border-gray-100">
              <div>
                <h2 class="text-2xl font-bold text-gray-900">Register New Student</h2>
                <p class="text-xs text-gray-500">Fill in the student details to create a new profile.</p>
              </div>
              <button onclick="state.showAddStudentModal = false; render();" class="text-gray-400 hover:text-gray-600">
                <i class="fa-solid fa-xmark text-lg"></i>
              </button>
            </div>

            <form onsubmit="handleAddStudentSubmit(event)" class="space-y-4 text-xs">
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block font-semibold text-gray-700 mb-1">First Name *</label>
                  <input type="text" required value="${a.firstName}" oninput="state.addForm.firstName = this.value" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-gradify-teal">
                </div>
                <div>
                  <label class="block font-semibold text-gray-700 mb-1">Last Name *</label>
                  <input type="text" required value="${a.lastName}" oninput="state.addForm.lastName = this.value" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-gradify-teal">
                </div>
                <div>
                  <label class="block font-semibold text-gray-700 mb-1">Section *</label>
                  <select onchange="state.addForm.section = this.value" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-gradify-teal bg-white">
                    <option value="7 · Acacia">7 · Acacia</option>
                    <option value="7 · Narra">7 · Narra</option>
                  </select>
                </div>
                <div>
                  <label class="block font-semibold text-gray-700 mb-1">Date of Birth</label>
                  <input type="date" value="${a.dob}" oninput="state.addForm.dob = this.value" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-gradify-teal">
                </div>
                <div>
                  <label class="block font-semibold text-gray-700 mb-1">Gender</label>
                  <select onchange="state.addForm.gender = this.value" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-gradify-teal bg-white">
                    <option value="Female">Female</option>
                    <option value="Male">Male</option>
                  </select>
                </div>
                <div>
                  <label class="block font-semibold text-gray-700 mb-1">Parent / Guardian Name</label>
                  <input type="text" value="${a.parentName}" oninput="state.addForm.parentName = this.value" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-gradify-teal">
                </div>
                <div>
                  <label class="block font-semibold text-gray-700 mb-1">Mobile Number</label>
                  <input type="text" value="${a.mobile}" oninput="state.addForm.mobile = this.value" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-gradify-teal">
                </div>
                <div>
                  <label class="block font-semibold text-gray-700 mb-1">Email Address</label>
                  <input type="email" value="${a.email}" oninput="state.addForm.email = this.value" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-gradify-teal">
                </div>
              </div>

              <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="state.showAddStudentModal = false; render();" class="px-4 py-2 border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold rounded-lg text-xs">
                  Cancel
                </button>
                <button type="submit" class="px-5 py-2 bg-gradify-teal hover:bg-gradify-teal-dark text-white font-semibold rounded-lg text-xs transition-colors shadow-sm">
                  Register Student
                </button>
              </div>
            </form>
          </div>
        </div>
      `;
    }

    // Discard Unsaved Changes Dialog (Edit student-1.png)
    function renderDiscardChangesModal() {
      if (!state.showDiscardChangesModal) return '';

      return `
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
          <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-4 border border-gray-100">
            <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-xl">
              <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div>
              <h3 class="text-xl font-bold text-gray-900">Discard unsaved changes?</h3>
              <p class="text-xs text-gray-500 mt-2 leading-relaxed">
                Your edits have not been saved. Keep editing to review them, or discard changes and return to the previous record.
              </p>
            </div>

            <div class="flex items-center justify-end space-x-3 pt-3">
              <button 
                onclick="state.showDiscardChangesModal = false; render();" 
                class="px-4 py-2 bg-gradify-teal text-white font-semibold rounded-lg text-xs hover:bg-gradify-teal-dark transition-colors"
              >
                Keep editing
              </button>
              <button 
                onclick="closeEditStudentModal(false);" 
                class="px-4 py-2 bg-rose-600 text-white font-semibold rounded-lg text-xs hover:bg-rose-700 transition-colors"
              >
                Discard changes
              </button>
            </div>
          </div>
        </div>
      `;
    }

    // Logout Confirmation Modal
    function renderLogoutModal() {
      if (!state.showLogoutModal) return '';

      return `
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
          <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-6 space-y-4 border border-gray-100">
            <div class="w-10 h-10 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center text-lg">
              <i class="fa-solid fa-arrow-right-from-bracket"></i>
            </div>

            <div>
              <h3 class="text-lg font-bold text-gray-900">Confirm Logout</h3>
              <p class="text-xs text-gray-500 mt-1">Are you sure you want to end your current session?</p>
            </div>

            <div class="flex items-center justify-end space-x-3 pt-2">
              <button 
                onclick="state.showLogoutModal = false; render();" 
                class="px-4 py-2 border border-gray-300 text-gray-700 font-semibold rounded-lg text-xs hover:bg-gray-50"
              >
                Cancel
              </button>
              <button 
                onclick="handleLogout()" 
                class="px-4 py-2 bg-rose-600 text-white font-semibold rounded-lg text-xs hover:bg-rose-700 transition-colors shadow-sm"
              >
                Logout
              </button>
            </div>
          </div>
        </div>
      `;
    }

    // Print Report Modal
    function renderPrintReportModal() {
      if (!state.showPrintReportModal) return '';

      return `
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
          <div class="bg-white rounded-2xl shadow-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto p-8 space-y-6">
            <div class="flex justify-between items-center pb-4 border-b">
              <h2 class="text-lg font-bold text-gray-900">Official Grade Summary Preview</h2>
              <button onclick="state.showPrintReportModal = false; render();" class="text-gray-400 hover:text-gray-600">
                <i class="fa-solid fa-xmark text-lg"></i>
              </button>
            </div>

            <!-- Printable Certificate Style View -->
            <div id="printableArea" class="border p-8 bg-white space-y-6 text-gray-900 font-sans">
              <div class="text-center space-y-1">
                <p class="text-xs uppercase tracking-widest font-bold text-gray-500">Asia Source iCollege – Pasig City Branch</p>
                <h1 class="text-xl font-black text-gray-900">Quarterly Academic Grade Report</h1>
                <p class="text-xs text-gray-600">Academic Year 2026–2027 · Quarter 1</p>
              </div>

              <div class="grid grid-cols-2 text-xs border-y py-3 border-gray-200">
                <div>
                  <p><span class="font-bold">Faculty Member:</span> Maria D. Cruz</p>
                  <p><span class="font-bold">Assigned Grade:</span> Grade 7 (Acacia & Narra)</p>
                </div>
                <div class="text-right">
                  <p><span class="font-bold">Date Generated:</span> October 19, 2026</p>
                  <p><span class="font-bold">Passing Standard:</span> 75.00 General Average</p>
                </div>
              </div>

              <table class="w-full text-left text-xs border-collapse">
                <thead>
                  <tr class="border-b-2 border-gray-300">
                    <th class="py-2">Student Name</th>
                    <th class="py-2">Section</th>
                    <th class="py-2 text-center">General Avg</th>
                    <th class="py-2 text-right">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                  ${state.students.map(s => `
                    <tr>
                      <td class="py-2 font-bold">${s.firstName} ${s.lastName}</td>
                      <td class="py-2">${s.section}</td>
                      <td class="py-2 text-center font-bold">${calcAverage(s.grades)}</td>
                      <td class="py-2 text-right">${isPassing(calcAverage(s.grades)) ? 'PASSED' : 'FAILED'}</td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            </div>

            <div class="flex justify-end space-x-3">
              <button 
                onclick="state.showPrintReportModal = false; render();" 
                class="px-4 py-2 border text-xs font-semibold rounded-lg hover:bg-gray-50"
              >
                Close
              </button>
              <button 
                onclick="window.print();" 
                class="px-5 py-2 bg-gradify-teal text-white text-xs font-semibold rounded-lg hover:bg-gradify-teal-dark"
              >
                <i class="fa-solid fa-print mr-1"></i> Print / Save as PDF
              </button>
            </div>
          </div>
        </div>
      `;
    }

    // Toast Banner Component
    function renderToast() {
      if (!state.toastMessage) return '';
      return `
        <div class="fixed bottom-6 right-6 z-50 bg-gray-900 text-white px-5 py-3 rounded-xl shadow-2xl text-xs font-semibold flex items-center space-x-3 transition-all animate-bounce">
          <i class="fa-solid fa-circle-check text-emerald-400 text-base"></i>
          <span>${state.toastMessage}</span>
        </div>
      `;
    }

    // --- MAIN RENDER FUNCTION ---
    function render() {
      const app = document.getElementById('app');

      if (!state.isLoggedIn) {
        app.innerHTML = renderLogin();
        return;
      }

      let content = '';
      switch (state.activeTab) {
        case 'dashboard':
          content = renderDashboard();
          break;
        case 'students':
          content = renderStudents();
          break;
        case 'grades':
          content = renderGrades();
          break;
        case 'reports':
          content = renderReports();
          break;
        case 'profile':
          content = renderProfile();
          break;
        default:
          content = renderDashboard();
      }

      app.innerHTML = `
        <div class="flex min-h-screen">
          ${renderSidebar()}
          <main class="flex-1 overflow-y-auto custom-scrollbar">
            ${content}
          </main>
        </div>
        ${renderEditStudentModal()}
        ${renderAddStudentModal()}
        ${renderDiscardChangesModal()}
        ${renderLogoutModal()}
        ${renderPrintReportModal()}
        ${renderToast()}
      `;
    }

    // Initialize Application
    window.onload = function() {
      render();
    };
  </script>
</body>
</html>
