                  onchange="
                    state.gradeEditorStudentId = this.value; 
                    const s = state.students.find(x => x.id === this.value);
                    if(s) state.gradeEditorTempGrades = {...s.grades};
                    state.gradeEditorStep = 2;
                    render();
                  "
                  class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-gradify-teal focus:border-gradify-teal outline-none bg-white"
                >
                  ${sectionStudents.map(s => `
                    <option value="${s.id}" ${s.id === selectedStudent.id ? 'selected' : ''}>
                      ${s.firstName} ${s.lastName} (${s.id})
                    </option>
                  `).join('')}
                </select>
              </div>
            </div>
          </div>

          <!-- Step 2: Subject Grades Form -->
          <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-gray-100 gap-2">
              <div>
                <h2 class="text-lg font-bold text-gray-900">${selectedStudent.firstName} ${selectedStudent.lastName}</h2>
                <p class="text-xs text-gray-500">Student ID: ${selectedStudent.id} · ${selectedStudent.section}</p>
              </div>
              <div class="text-left sm:text-right">
                <span class="text-3xl font-black text-gray-900">${tempAvg}</span>
                <div class="mt-0.5">
                  <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold ${
                    tempPass ? 'bg-gradify-pass text-gradify-pass-text' : 'bg-gradify-fail text-gradify-fail-text'
                  }">
                    ${tempPass ? 'Passing' : 'Failing'}
                  </span>
                </div>
              </div>
            </div>

            <!-- Grade Inputs Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
              ${Object.entries(state.gradeEditorTempGrades).map(([subject, val]) => {
                const isFail = Number(val) < 75;
                return `
                  <div class="p-3.5 border rounded-xl transition-all ${isFail ? 'border-rose-300 bg-rose-50/30' : 'border-gray-200 bg-gray-50/50'}">
                    <label class="block text-xs font-bold text-gray-800 mb-1.5">${subject}</label>
                    <div class="relative">
                      <input 
                        type="number" 
                        min="0" 
                        max="100"
                        value="${val}"
                        oninput="
                          state.gradeEditorTempGrades['${subject}'] = Math.min(100, Math.max(0, parseFloat(this.value) || 0));
                          render();
                        "
                        class="w-full text-base font-bold text-gray-900 border ${isFail ? 'border-rose-400 focus:ring-rose-400' : 'border-gray-300 focus:ring-gradify-teal'} rounded-lg px-3 py-1.5 outline-none bg-white"
                      />
                      <span class="absolute right-3 top-2.5 text-xs text-gray-400 font-semibold">%</span>
                    </div>
                    ${isFail ? `<p class="text-[10px] text-rose-600 font-semibold mt-1"><i class="fa-solid fa-triangle-exclamation mr-1"></i> Below threshold (75)</p>` : ''}
                  </div>
                `;
              }).join('')}
            </div>

            <!-- Academic Support Priority Warning -->
            ${lowSubjects.length > 0 ? `
              <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 flex items-start space-x-3 text-amber-900 text-xs">
                <i class="fa-solid fa-circle-exclamation text-amber-600 text-base mt-0.5"></i>
                <div>
                  <p class="font-bold">Academic Support Needed</p>
                  <p class="mt-0.5 text-amber-800 leading-relaxed">
                    This student is scoring below 75 in: <span class="font-bold">${lowSubjects.map(s => s[0]).join(', ')}</span>.
                    Remedial sessions or parent consultation is recommended.
                  </p>
                </div>
              </div>
            ` : ''}

            <!-- Action Buttons -->
            <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-100">
              <button 
                onclick="
                  state.gradeEditorTempGrades = {...selectedStudent.grades};
                  showToast('Reverted modifications.');
                  render();
                "
                class="px-4 py-2 border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold rounded-lg text-xs transition-colors"
              >
                Reset Changes
              </button>
              <button 
                onclick="handleSaveGrades()"
                class="px-5 py-2 bg-gradify-teal hover:bg-gradify-teal-dark text-white font-semibold rounded-lg text-xs transition-colors shadow-sm inline-flex items-center gap-2"
              >
                <i class="fa-solid fa-check text-xs"></i>
                <span>Save Grades & Calculate</span>
              </button>
            </div>
          </div>
        </div>
      `;
    }

