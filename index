    // Save to LocalStorage
    function persistData() {
      localStorage.setItem('gradify_students', JSON.stringify(state.students));
    }

    // Helper: Compute average grade for a student
    function calcAverage(grades) {
      if (!grades) return "0.00";
      const keys = Object.keys(grades);
      if (keys.length === 0) return "0.00";
      const sum = keys.reduce((acc, k) => acc + (parseFloat(grades[k]) || 0), 0);
      return (sum / keys.length).toFixed(2);
    }

    // Helper: Check passing status (Threshold 75)
    function isPassing(average) {
      return parseFloat(average) >= 75.00;
    }

    // Helper: Show Toast Notification
    function showToast(msg) {
      state.toastMessage = msg;
      render();
      setTimeout(() => {
        state.toastMessage = null;
        render();
      }, 3500);
    }

    // --- Action Handlers ---
    function setTab(tab, studentId = null) {
      state.activeTab = tab;
      if (studentId) {
        state.selectedStudentId = studentId;
      }
      if (tab === 'grades') {
        state.gradeEditorStep = 1;
        if (studentId) {
          state.gradeEditorStudentId = studentId;
          const s = state.students.find(x => x.id === studentId);
          if (s) {
            state.gradeEditorSection = s.section;
            state.gradeEditorTempGrades = { ...s.grades };
            state.gradeEditorStep = 2;
          }
        }
      }
      render();
    }

    function openEditStudentModal(student) {
      state.editForm = JSON.parse(JSON.stringify(student));
      state.isEditFormDirty = false;
      state.showEditStudentModal = true;
      render();
    }

    function closeEditStudentModal(checkDirty = true) {
      if (checkDirty && state.isEditFormDirty) {
        state.showDiscardChangesModal = true;
      } else {
        state.showEditStudentModal = false;
        state.showDiscardChangesModal = false;
        state.isEditFormDirty = false;
      }
      render();
    }

    function saveStudentEdits(e) {
      e.preventDefault();
      const idx = state.students.findIndex(s => s.id === state.editForm.id);
      if (idx !== -1) {
        // Format raw section label
        state.editForm.rawSection = state.editForm.section.includes('Acacia') ? 'Acacia' : 'Narra';
        state.students[idx] = { ...state.editForm };
        persistData();
        showToast(`Updated ${state.editForm.firstName} ${state.editForm.lastName}'s details.`);
      }
      state.showEditStudentModal = false;
      state.isEditFormDirty = false;
      render();
    }

    function handleAddStudentSubmit(e) {
      e.preventDefault();
      const newId = `2026-00${state.students.length + 1}`;
      const rawSec = state.addForm.section.includes('Acacia') ? 'Acacia' : 'Narra';
      
      const newStudent = {
        id: newId,
        firstName: state.addForm.firstName,
        lastName: state.addForm.lastName,
        grade: "Grade 7",
        section: state.addForm.section,
        rawSection: rawSec,
        dob: state.addForm.dob,
        dobFormatted: state.addForm.dob ? new Date(state.addForm.dob).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'N/A',
        gender: state.addForm.gender,
        status: "Enrolled",
        parentName: state.addForm.parentName,
        relationship: state.addForm.relationship,
        mobile: state.addForm.mobile,
        email: state.addForm.email,
        address: state.addForm.address,
        teacherNotes: state.addForm.teacherNotes,
        grades: {
          English: 75,
          Math: 75,
          Science: 75,
          Filipino: 75,
          "Araling Panlipunan": 75,
          MAPEH: 75
        }
      };

      state.students.push(newStudent);
      persistData();
      state.showAddStudentModal = false;
      showToast(`Student ${newStudent.firstName} ${newStudent.lastName} registered successfully!`);
      // Reset form
      state.addForm = {
        firstName: '', lastName: '', studentId: '', section: '7 · Acacia', dob: '',
        gender: 'Female', parentName: '', relationship: 'Mother', mobile: '', email: '', address: '', teacherNotes: ''
      };
      render();
    }

    function handleLoginSubmit(e) {
      e.preventDefault();
      state.loginErrors = {};
      if (!state.loginEmail.trim()) {
        state.loginErrors.email = 'School email is required.';
      }
      if (!state.loginPassword.trim()) {
        state.loginErrors.password = 'Password is required.';
      }

      if (Object.keys(state.loginErrors).length === 0) {
        state.isLoggedIn = true;
        state.activeTab = 'dashboard';
        showToast("Welcome back, Teacher Maria!");
      }
      render();
    }

    function handleLogout() {
      state.isLoggedIn = false;
      state.showLogoutModal = false;
      render();
    }

    function handleSaveGrades() {
      const student = state.students.find(s => s.id === state.gradeEditorStudentId);
      if (student) {
        student.grades = { ...state.gradeEditorTempGrades };
        persistData();
        showToast(`Grades for ${student.firstName} ${student.lastName} saved successfully!`);
        state.gradeEditorStep = 3;
      }
      render();
    }

